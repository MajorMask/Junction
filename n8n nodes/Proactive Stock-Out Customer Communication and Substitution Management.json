    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "=Product Unavailable - Order #{{ $json.order_number }}",
        "message": "=<html>\n<body>\n  <h2>Product Unavailability Notice</h2>\n  <p>Dear Valued Customer,</p>\n  <p>We regret to inform you that a product in your order <strong>#{{ $json.order_number }}</strong> is currently unavailable.</p>\n  <p><strong>Unavailable Product:</strong> {{ $json.product_name }}</p>\n  <p>We have identified suitable substitutes for your consideration. Please click the link below to review and select your preferred alternative:</p>\n  <p><a href=\"{{ $json.webapp_url }}\" style=\"display: inline-block; padding: 12px 24px; background-color: #007bff; color: white; text-decoration: none; border-radius: 4px;\">View Substitute Options</a></p>\n  <p>If you have any questions or concerns, please don't hesitate to contact us.</p>\n  <p>Thank you for your understanding.</p>\n  <p>Best regards,<br>Your Customer Service Team</p>\n</body>\n</html>",
        "options": {}
