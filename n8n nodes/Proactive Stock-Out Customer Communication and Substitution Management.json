    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst scripts = {\n  fi: (data) => `Hei, täällä Valio Aimo. Valitettavasti tuote ${data.product_name} (koodi ${data.product_code}) ei ole saatavilla toimitukseesi kello ${data.delivery_time}. Voimme tarjota korvaavia tuotteita: 1. ${data.substitute_1_name} - ${data.substitute_1_reason}, 2. ${data.substitute_2_name} - ${data.substitute_2_reason}, 3. ${data.substitute_3_name} - ${data.substitute_3_reason}. Haluatko hyväksyä jonkin korvaavan tuotteen? Sano numero 1, 2 tai 3, tai 'ei kiitos' jos et halua korvaavaa tuotetta.`,\n  sv: (data) => `Hej, här är Valio Aimo. Tyvärr är produkten ${data.product_name} (kod ${data.product_code}) inte tillgänglig för din leverans klockan ${data.delivery_time}. Vi kan erbjuda ersättningsprodukter: 1. ${data.substitute_1_name} - ${data.substitute_1_reason}, 2. ${data.substitute_2_name} - ${data.substitute_2_reason}, 3. ${data.substitute_3_name} - ${data.substitute_3_reason}. Vill du acceptera någon ersättningsprodukt? Säg nummer 1, 2 eller 3, eller 'nej tack' om du inte vill ha en ersättningsprodukt.`,\n  en: (data) => `Hello, this is Valio Aimo. Unfortunately, product ${data.product_name} (code ${data.product_code}) is not available for your delivery at ${data.delivery_time}. We can offer substitute products: 1. ${data.substitute_1_name} - ${data.substitute_1_reason}, 2. ${data.substitute_2_name} - ${data.substitute_2_reason}, 3. ${data.substitute_3_name} - ${data.substitute_3_reason}. Would you like to accept any substitute product? Say number 1, 2, or 3, or 'no thanks' if you don't want a substitute.`\n};\n\nreturn items.map(item => {\n  const language = item.json.language || 'fi';\n  const script = scripts[language](item.json);\n  \n  return {\n    json: {\n      ...item.json,\n      callScript: script,\n      language\n    }\n  };\n});"
      },
