    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const response = item.json;\n  let customerDecision = null;\n  let selectedSubstitute = null;\n  let responded = false;\n  \n  // Check if customer responded (webhook was called)\n  if (response.customer_response) {\n    responded = true;\n    \n    // Parse response based on channel\n    if (response.intent === 'ACCEPT_SUBSTITUTE_1' || response.choice === '1') {\n      customerDecision = 'accepted';\n      selectedSubstitute = response.substitute_1_code;\n    } else if (response.intent === 'ACCEPT_SUBSTITUTE_2' || response.choice === '2') {\n      customerDecision = 'accepted';\n      selectedSubstitute = response.substitute_2_code;\n    } else if (response.intent === 'ACCEPT_SUBSTITUTE_3' || response.choice === '3') {\n      customerDecision = 'accepted';\n      selectedSubstitute = response.substitute_3_code;\n    } else if (response.intent === 'DECLINE_ALL' || response.choice === 'decline') {\n      customerDecision = 'declined';\n    }\n  }\n  \n  return {\n    json: {\n      ...response,\n      customerDecision,\n      selectedSubstitute,\n      responded,\n      responseTimestamp: new Date().toISOString()\n    }\n  };\n});"
      },
      "id": "8f4348b7-7470-4c5d-94c7-d9aa33c97e5a",
      "name": "Process Customer Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
