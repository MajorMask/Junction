    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst config = $('Workflow Configuration').first().json;\nconst currentHour = new Date().getHours();\n\nreturn items.map(item => {\n  const customerPrefs = item.json;\n  const nightModeEnabled = customerPrefs.night_mode === true;\n  const isNightTime = currentHour >= config.nightModeStartHour && currentHour < config.nightModeEndHour;\n  const shouldDefer = nightModeEnabled && isNightTime && !['sms', 'email'].includes(customerPrefs.communication_channel);\n  \n  return {\n    json: {\n      ...item.json,\n      shouldDefer,\n      isNightTime,\n      currentHour,\n      deferUntilTime: shouldDefer ? `${config.nightModeEndHour}:00` : null\n    }\n  };\n});"
      },
